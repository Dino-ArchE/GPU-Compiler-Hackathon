.version 8.0
.target sm_89
.address_size 64

.visible .entry k_add_pointwise(
	.param .u64 param_x0,
	.param .u64 param_x1,
	.param .u64 param_add
)
{
	.reg .b64 %rd<20>;
	.reg .b32 %r<16>;
	.reg .pred %p<1>;
	.reg .f32 %f<6>;
ENTRY_0:
	ld.param.u64 %rd0, [param_x0];
	cvta.to.global.u64 %rd1, %rd0;
	ld.param.u64 %rd2, [param_x1];
	cvta.to.global.u64 %rd3, %rd2;
	ld.param.u64 %rd4, [param_add];
	cvta.to.global.u64 %rd5, %rd4;
	mov.u32 %r0, %ctaid.x;
	mov.u32 %r2, %tid.x;
	mad.lo.s32 %r3, %r0, 256, %r2;
	setp.ge.s32 %p0, %r3, 64;
	@%p0 bra EXIT_1;
BB_2:
	shl.b32 %r6, %r3, 1;
	mul.wide.s32 %rd6, %r6, 4;
	add.s64 %rd7, %rd1, %rd6;
	ld.global.nc.v2.f32 {%f0, %f3}, [%rd7];
	add.s64 %rd9, %rd3, %rd6;
	ld.global.nc.v2.f32 {%f1, %f4}, [%rd9];
	add.f32 %f2, %f0, %f1;
	add.f32 %f5, %f3, %f4;
	add.s64 %rd15, %rd5, %rd6;
	st.global.v2.f32 [%rd15], {%f2, %f5};
EXIT_1:
	ret;
}
